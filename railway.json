{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfig": {
      "languages": {
        "java": {
          "version": "21"
        }
      },
      "phases": {
        "install": {
          "cmds": [
            "mvn clean package"
          ]
        },
        "start": {
          "cmds": [
            "java -jar target/JavaMockExam-1.0-SNAPSHOT.jar"
          ]
        }
      }
    }
  }
}